# Imagem do dashboard de monitoramento.
#
# Mantida separada da API de propósito: a API não precisa do Streamlit, e
# o dashboard não precisa do PyTorch. Essa separação evita incluir o
# runtime pesado de ML na imagem de visualização — especialmente
# importante porque é a imagem da API que precisa caber no free tier.
#
# O Pandas aparece nas duas imagens: a API o utiliza por meio de
# `app/features.py`, por isso também está declarado em `requirements.txt`.
#
# As versões abaixo são fixadas manualmente e repetem as versões de
# `requirements-train.txt`. É uma duplicação consciente para manter esta
# imagem independente do arquivo de treino. Ao atualizar uma versão,
# atualize a outra também.

FROM python:3.11-slim

RUN useradd --create-home --shell /bin/bash appuser
WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit==1.41.1 \
    pandas==2.2.3

COPY dashboard/ ./dashboard/

ENV PYTHONUNBUFFERED=1 \
    DB_PATH=/app/data/monitoring.db \
    REGISTRY_PATH=/app/models/registry.json

# Os diretórios existem para servir como pontos de montagem. No Docker
# Compose, eles são sobrescritos por bind mounts montados em modo somente
# leitura.
RUN mkdir -p /app/data /app/models && chown -R appuser:appuser /app
USER appuser

EXPOSE 8501

# Endpoint de saúde interno do Streamlit.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; \
        sys.exit(0 if urllib.request.urlopen('http://localhost:8501/_stcore/health').status==200 else 1)"

CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.address=0.0.0.0", "--server.port=8501", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
