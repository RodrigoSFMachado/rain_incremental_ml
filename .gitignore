# ═══════════════════════════════════════════════════════════════
# Dados
# ═══════════════════════════════════════════════════════════════

# O CSV bruto tem ~31 MB e é público: quem clonar baixa da fonte
# (Iowa Environmental Mesonet). O Parquet é derivado dele.
data/*.csv
data/*.parquet

# Banco de monitoramento: criado em runtime pela API, cresce com o uso
# e é específico da execução de cada pessoa.
data/*.db
data/*.sqlite
data/*.sqlite3

# Mantém a pasta `data/` no repositório mesmo estando vazia.
!data/.gitkeep


# ═══════════════════════════════════════════════════════════════
# MLflow
# ═══════════════════════════════════════════════════════════════

# O histórico de runs é local e pessoal. As métricas relevantes já estão
# documentadas no README.
mlflow.db
mlruns/
mlartifacts/


# ═══════════════════════════════════════════════════════════════
# Modelos
# ═══════════════════════════════════════════════════════════════

# O checkpoint baseline (v1) é pequeno (~10 KB) e faz parte do
# artefato entregue. Por isso model.pt e registry.json NÃO são
# ignorados e devem estar versionados.
#
# Se quiser regenerar o baseline, execute:
#   python -m training.train_initial --no-mlflow


# ═══════════════════════════════════════════════════════════════
# Python
# ═══════════════════════════════════════════════════════════════

__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Ambientes virtuais
.venv/
venv/
env/
ENV/
.conda/

# Empacotamento
build/
dist/
*.egg-info/
.eggs/

# Testes e cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/


# ═══════════════════════════════════════════════════════════════
# Configuração e segredos
# ═══════════════════════════════════════════════════════════════

# O projeto não usa `.env` atualmente, mas esta regra impede que
# credenciais sejam adicionadas ao histórico do Git.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json


# ═══════════════════════════════════════════════════════════════
# Editores
# ═══════════════════════════════════════════════════════════════

.vscode/
.idea/
*.swp
*.swo
*~


# ═══════════════════════════════════════════════════════════════
# Sistema operacional
# ═══════════════════════════════════════════════════════════════

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble

