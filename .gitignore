# ═══════════════════════════════════════════════════════════════
# Dados
# ═══════════════════════════════════════════════════════════════

# O CSV bruto tem 31 MB e é público: quem clonar baixa-o da fonte
# (Iowa Environmental Mesonet). O Parquet é derivado dele.
data/*.csv
data/*.parquet

# Banco de monitoramento: criado em runtime pela API, cresce com o uso
# e é específico da execução de cada pessoa.
data/*.db
data/*.sqlite
data/*.sqlite3

# Mantém a pasta `data/` no repositório mesmo estando vazia, para que
# quem clonar não precise criá-la manualmente.
!data/.gitkeep


# ═══════════════════════════════════════════════════════════════
# MLflow
# ═══════════════════════════════════════════════════════════════

# O histórico de runs é local e pessoal. As métricas relevantes já estão
# documentadas no README.
mlflow.db
mlruns/
mlartifacts/


# ═══════════════════════════════════════════════════════════════
# ATENÇÃO: o que NÃO deve ser ignorado
# ═══════════════════════════════════════════════════════════════

# `models/model.pt` tem 9,6 KB, e o Dockerfile executa `COPY models/`.
# Se o arquivo for ignorado, o build da imagem falhará.
models/model.pt
models/registry.json

# Isso pode parecer contraintuitivo, porque arquivos `.pt` costumam ser
# binários grandes. Neste projeto, o checkpoint é pequeno e faz parte
# do artefato entregue.

# Antes de commitar, confirme que o modelo é o do treinamento inicial:
# python -m training.train_initial --no-mlflow
#
# Executar `simulate_production.py` sobrescreve `model.pt`.


# ═══════════════════════════════════════════════════════════════
# Python
# ═══════════════════════════════════════════════════════════════

__pycache__/
*.py[cod]
*$py.class
*.so
.Python


# Ambientes virtuais
.venv/
venv/
env/
ENV/
.conda/


# Empacotamento
build/
dist/
*.egg-info/
.eggs/


# Testes e cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/


# ═══════════════════════════════════════════════════════════════
# Configuração e segredos
# ═══════════════════════════════════════════════════════════════

# O projeto não usa `.env` atualmente, mas esta regra impede que
# credenciais sejam adicionadas ao histórico do Git. Depois de
# commitado, um segredo continua no histórico mesmo se for removido.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json


